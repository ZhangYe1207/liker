+        "content": f"【收藏数据参考】\n{context_text}\n\n【用户问题】\n{current_message}",
+    }
+    return [
+        {"role": "system", "content": SYSTEM_PROMPT},
+        *prior,
+        augmented_user,
+    ]
+
+
 async def chat_with_rag(
